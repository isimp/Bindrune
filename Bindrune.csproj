<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Bindrune</AssemblyName>
    <RootNamespace>Bindrune</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>0.5.1</Version>
    <Authors>isimp</Authors>
    <Product>Bindrune</Product>
    <Description>Every keybind from every mod and the game itself in one panel, with the clashes between them explained.</Description>
    <Copyright>Copyright (c) 2026 isimp</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <Import Project="BuildChecks.props" />
  <Import Project="GameReferences.props" />

  <!-- The tests are projects of their own (see tests/), and the in-game self-test a plugin of its
       own (see selftest/), which reaches Bindrune's insides as granted here. A release takes
       Bindrune.dll alone. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Compile Remove="selftest/**" />
    <None Remove="selftest/**" />
    <InternalsVisibleTo Include="Bindrune.SelfTest" />
  </ItemGroup>

  <!-- Only when building against a real install: a build server has no profile to deploy to. -->
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="'$(LibsDir)' == '' And Exists('$(BepInExDir)\plugins')">
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" ContinueOnError="true" />
    <Message Importance="high" Text="Bindrune -> $(DeployDir)" />
  </Target>

</Project>
